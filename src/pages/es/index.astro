---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Precision from '../../components/Precision.astro';
import Work from '../../components/Work.astro';
import Reviews from '../../components/Reviews.astro';
import Visit from '../../components/Visit.astro';
import Footer from '../../components/Footer.astro';
import { site, rating } from '../../data/site';
import { t } from '../../i18n/es';
---
<Layout title={t.meta.title} description={t.meta.description} lang={t.lang}>
  <Header site={site} t={t} />
  <main id="contenido">
    <Hero site={site} t={t} />
    <Services t={t} />
    <Precision t={t} />
    <Work site={site} t={t} />
    <Reviews site={site} t={t} />
    <Visit site={site} t={t} />
  </main>
  <Footer site={site} t={t} />
</Layout>
