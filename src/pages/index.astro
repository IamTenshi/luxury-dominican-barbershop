---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Precision from '../components/Precision.astro';
import Work from '../components/Work.astro';
import Reviews from '../components/Reviews.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Layout
  title={`${site.name} — Barbería dominicana en ${site.city}`}
  description="Fades nítidos, barba detallada y recortes de precisión en Luxury Dominican Barbershop, Loganville, Georgia. Sin cita: entra y siéntate."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Services />
    <Precision />
    <Work />
    <Reviews />
    <Visit />
  </main>
  <Footer />
</Layout>
