---
import { services } from '../data/site';
---
<section id="servicios" class="mx-auto max-w-[1100px] px-5 py-16 max-sm:py-12">
  <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.22em] text-muted">
    {services.kicker}
  </p>
  <h2 class="text-[clamp(30px,4.5vw,44px)] font-extrabold tracking-tight">{services.heading}</h2>
  <p class="mt-3 max-w-[560px] text-muted">{services.intro}</p>
  <div class="mt-10 grid grid-cols-2 gap-5 max-sm:grid-cols-1">
    {services.items.map((service) => (
      <article class="border border-line bg-paper">
        <img
          src={service.image}
          alt={service.imageAlt}
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
        />
        <div class="p-6">
          <span class="text-sm font-extrabold text-muted">{service.num}</span>
          <h3 class="mt-1 text-xl font-extrabold">{service.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{service.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
