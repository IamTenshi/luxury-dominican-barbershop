---
import { precision } from '../data/site';
---
<section class="bg-coal text-cream">
  <div class="mx-auto grid max-w-[1100px] grid-cols-2 items-center gap-10 px-5 py-16 max-md:grid-cols-1 max-sm:py-12">
    <div>
      <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.22em] text-sand">
        {precision.kicker}
      </p>
      <h2 class="text-[clamp(30px,4.5vw,44px)] font-extrabold tracking-tight">
        {precision.heading}
      </h2>
      <p class="mt-4 leading-relaxed text-cream/80">{precision.text}</p>
      <p class="mt-4 border-l-2 border-cream/40 pl-4 font-bold leading-relaxed">
        {precision.heritage}
      </p>
      <div class="mt-8 grid grid-cols-2 gap-4 max-sm:grid-cols-1">
        {precision.details.map((d) => (
          <div>
            <strong class="block text-sm font-extrabold">{d.title}</strong>
            <span class="text-sm text-cream/70">{d.text}</span>
          </div>
        ))}
      </div>
    </div>
    <img
      src={precision.image}
      alt={precision.imageAlt}
      class="aspect-[4/5] w-full object-cover"
    />
  </div>
</section>
