---
import { site, hero, rating } from '../data/site';
---
<section id="top" class="mx-auto max-w-[1100px] px-5 pb-14 pt-12 text-center max-sm:pt-10">
  <p class="mb-5 text-xs font-extrabold uppercase tracking-[0.22em] text-muted">
    {hero.eyebrow} — {site.city}
  </p>
  <h1 class="mx-auto max-w-[720px] text-[clamp(38px,6vw,64px)] font-extrabold leading-[1.05] tracking-tight">
    {hero.titleA} {hero.titleB}
  </h1>
  <p class="mx-auto mt-5 max-w-[560px] text-lg leading-relaxed text-muted">
    {hero.description}
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a
      href={`tel:${site.phone}`}
      class="bg-ink px-7 py-3.5 text-sm font-extrabold text-paper no-underline"
    >
      Llamar {site.phoneDisplay}
    </a>
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener"
      class="border border-ink/30 px-7 py-3.5 text-sm font-extrabold text-ink no-underline"
    >
      Cómo llegar
    </a>
  </div>
  <div class="mt-6 flex flex-col items-center gap-1.5">
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 text-sm font-extrabold no-underline"
    >
      <span class="tracking-[0.18em]" aria-hidden="true">★★★★★</span>
      <span>{rating.stars} · {rating.reviews} reseñas en {rating.source}</span>
    </a>
    <p class="text-sm font-bold text-muted">+5,000 clientes satisfechos · 7 barberos profesionales</p>
  </div>
  <img
    src={hero.image}
    alt={hero.imageAlt}
    class="mx-auto mt-10 aspect-[16/9] w-full max-w-[880px] object-cover"
  />
  <p class="mt-4 text-sm font-bold text-muted">Sin cita — entra y siéntate · Abierto todos los días</p>
</section>
