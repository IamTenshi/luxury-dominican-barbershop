---
import { work } from '../data/site';
---
<section id="trabajos" class="mx-auto max-w-[1100px] px-5 py-16 max-sm:py-12">
  <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.22em] text-muted">
    {work.kicker}
  </p>
  <h2 class="text-[clamp(30px,4.5vw,44px)] font-extrabold tracking-tight">{work.heading}</h2>
  <p class="mt-3 text-muted">{work.intro}</p>
  <div class="mt-10 grid grid-cols-3 gap-4 max-sm:grid-cols-1">
    {work.images.map((img) => (
      <img src={img.src} alt={img.alt} class="aspect-square w-full object-cover" loading="lazy" />
    ))}
  </div>
  <p class="mt-6 text-center">
    <a
      href="https://www.instagram.com/luxury.dominican_barbershop"
      target="_blank"
      rel="noopener"
      class="text-sm font-extrabold underline underline-offset-4"
    >
      Ver más en Instagram
    </a>
  </p>
</section>
