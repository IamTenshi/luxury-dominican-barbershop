---
const { t, site } = Astro.props;
const visit = t.visit;
const hours = t.hours;
---
<section id={visit.id} class="border-t border-line">
  <div class="mx-auto grid max-w-[1100px] grid-cols-2 items-start gap-10 px-5 py-16 max-md:grid-cols-1 max-sm:py-12">
    <div>
      <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.22em] text-muted">
        {visit.kicker}
      </p>
      <h2 class="text-[clamp(30px,4.5vw,44px)] font-extrabold tracking-tight">{visit.heading}</h2>
      <p class="mt-3 max-w-[480px] leading-relaxed text-muted">{visit.lead}</p>
      <div class="mt-8 space-y-6">
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-[0.18em] text-muted">{visit.addressLabel}</h3>
          <p class="mt-1 font-bold">
            {site.address.place}<br />
            {site.address.street}<br />
            {site.address.city}
          </p>
        </div>
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-[0.18em] text-muted">{visit.hoursLabel}</h3>
          <div class="mt-1 font-bold">
            {hours.map((h) => (
              <p class="flex justify-between gap-4 py-0.5">
                <span>{h.days}</span>
                <span class="font-normal text-muted">{h.time}</span>
              </p>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-[0.18em] text-muted">{visit.phoneLabel}</h3>
          <a href={`tel:${site.phone}`} class="mt-1 inline-block text-xl font-extrabold underline underline-offset-4">
            {site.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener"
          class="bg-ink px-7 py-3.5 text-sm font-extrabold text-paper no-underline"
        >
          {visit.mapsCta}
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          class="border border-ink/30 px-7 py-3.5 text-sm font-extrabold text-ink no-underline"
        >
          Instagram
        </a>
      </div>
    </div>
    <div>
      <img src={visit.image} alt={visit.imageAlt} class="aspect-[4/5] w-full object-cover" />
      <p class="mt-3 text-sm font-bold text-muted">{visit.imageCaption}</p>
    </div>
  </div>
</section>
